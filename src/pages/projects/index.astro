---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Proyectos | Carlos Chin">
  <div class="container mx-auto px-4 md:px-8 py-24">
    <div class="max-w-2xl mb-16">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">Mis Proyectos</h1>
      <p class="text-gray-400 text-lg">
        Una colección de mis desarrollos recientes enfocados en ciberseguridad,
        automatización y desarrollo full-stack.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      {
        sortedProjects.map((project) => (
          <a
            href={`/projects/${project.id}`}
            class="group rounded-2xl bg-dark-surface border border-dark-border overflow-hidden hover:border-neon-purple/50 transition-all hover:shadow-[0_0_30px_rgba(147,51,234,0.15)] flex flex-col"
          >
            <div class="aspect-video overflow-hidden relative">
              <div class="absolute inset-0 bg-neon-purple/10 group-hover:bg-transparent transition-colors z-10" />
              <img
                src={project.data.image}
                alt={project.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-8 flex-grow flex flex-col">
              <h2 class="text-2xl font-bold mb-4 group-hover:text-neon-purple transition-colors">
                {project.data.title}
              </h2>
              <p class="text-gray-400 mb-8 flex-grow">
                {project.data.description}
              </p>
              <div class="flex flex-wrap gap-2">
                {project.data.tags.map((tag) => (
                  <span class="px-3 py-1.5 rounded-md bg-dark-bg border border-dark-border text-sm font-medium text-gray-300">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
