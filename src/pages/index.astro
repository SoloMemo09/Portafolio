---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const skills = [
  {
    name: "Astro",
    icon: '<img src="https://cdn.simpleicons.org/astro/white" alt="Astro" class="w-12 h-12" />',
    level: "90%",
  },
  {
    name: "Python",
    icon: '<img src="https://cdn.simpleicons.org/python/white" alt="Python" class="w-12 h-12" />',
    level: "85%",
  },
  {
    name: "Node.js",
    icon: '<img src="https://cdn.simpleicons.org/nodedotjs/white" alt="Node.js" class="w-12 h-12" />',
    level: "80%",
  },
  {
    name: "Ciberseguridad",
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
    level: "85%",
  },
  {
    name: "Flujos con N8N",
    icon: '<img src="https://cdn.simpleicons.org/n8n/white" alt="n8n" class="w-12 h-12" />',
    level: "90%",
  },
];
---

<Layout title="Carlos Chin | Portfolio">
  <!-- Hero Section -->
  <section class="relative pt-20 pb-32 overflow-hidden">
    <!-- Glowing background elements -->
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-neon-purple/20 rounded-full blur-[100px] -z-10 pointer-events-none"
    >
    </div>
    <div
      class="absolute top-0 right-0 w-[400px] h-[400px] bg-neon-blue/10 rounded-full blur-[80px] -z-10 pointer-events-none"
    >
    </div>

    <div class="container mx-auto px-4 md:px-8">
      <div
        class="flex flex-col items-center gap-8 max-w-4xl mx-auto text-center z-10 relative"
      >
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-dark-border/50 border border-dark-border text-sm font-medium"
        >
          <span class="w-2 h-2 rounded-full bg-neon-purple"></span>
          <a
            href="https://www.linkedin.com/in/carlos-guillermo-chin-cervera-bb4077387"
            >Disponible para trabajar
          </a>
        </div>
        <h1 class="text-5xl md:text-7xl font-bold tracking-tight">
          Hola, soy <br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-neon-purple to-neon-blue"
          >
            Carlos Chin
          </span>
        </h1>
        <h2 class="text-xl md:text-2xl text-gray-400 font-medium">
          Estudiante en Ingeniería en Sistemas Computacionales | Ciberseguridad
        </h2>
        <p class="text-gray-400 max-w-2xl mx-auto text-lg">
          Estudiante de Ingeniería en Sistemas Computacionales. Experiencia
          práctica en desarrollo web, despliegue de arquitecturas y
          documentación técnica. Construyo soluciones robustas y seguras.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
          <a
            href="/projects"
            class="px-6 py-3 rounded-md bg-neon-purple hover:bg-neon-purple/90 text-white font-medium transition-colors shadow-[0_0_20px_rgba(147,51,234,0.3)]"
          >
            Ver Proyectos
          </a>
          <a
            href="https://github.com/SoloMemo09"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-md bg-dark-border hover:bg-dark-border/80 text-white font-medium transition-colors flex items-center gap-2"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path
                d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
              ></path></svg
            >
            GitHub
          </a>
          <a
            href="https://www.linkedin.com/in/carlos-guillermo-chin-cervera-bb4077387"
            target="_blank"
            rel="noopener noreferrer"
            class="p-3 rounded-md bg-dark-border hover:bg-dark-border/80 text-white transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="currentColor"
              ><path
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
              ></path></svg
            >
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Summary -->
  <section class="py-16 bg-dark-surface/50 border-y border-dark-border">
    <div class="container mx-auto px-4 md:px-8">
      <h3 class="text-2xl font-bold mb-8 text-center">Tech Stack Principal</h3>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {
          skills.map((skill) => (
            <div class="p-6 rounded-xl bg-dark-bg border border-dark-border hover:border-neon-purple/50 transition-colors group">
              <div
                class="mb-4 group-hover:scale-110 transition-transform"
                set:html={skill.icon}
              />
              <h4 class="font-medium text-lg">{skill.name}</h4>
              <div class="w-full bg-dark-surface rounded-full h-1.5 mt-4 overflow-hidden">
                <div
                  class="bg-gradient-to-r from-neon-purple to-neon-blue h-1.5 rounded-full"
                  style={`width: ${skill.level}`}
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="py-24">
    <div class="container mx-auto px-4 md:px-8">
      <div class="flex items-end justify-between mb-12">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold">Proyectos Destacados</h2>
          <p class="text-gray-400 mt-2">
            Una selección de mi trabajo reciente.
          </p>
        </div>
        <a
          href="/projects"
          class="hidden md:flex items-center gap-2 text-neon-purple hover:text-neon-purple/80 font-medium transition-colors"
        >
          Ver todos <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
          >
        </a>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {
          featuredProjects.map((project) => (
            <a
              href={`/projects/${project.id}`}
              class="group rounded-2xl bg-dark-surface border border-dark-border overflow-hidden hover:border-neon-purple/50 transition-colors flex flex-col h-full"
            >
              <div class="aspect-video overflow-hidden relative">
                <div class="absolute inset-0 bg-neon-purple/10 group-hover:bg-transparent transition-colors z-10" />
                <img
                  src={project.data.image}
                  alt={project.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
              <div class="p-6 flex-grow flex flex-col">
                <h3 class="text-xl font-bold mb-2 group-hover:text-neon-purple transition-colors">
                  {project.data.title}
                </h3>
                <p class="text-gray-400 text-sm mb-6 flex-grow">
                  {project.data.description}
                </p>
                <div class="flex flex-wrap gap-2">
                  {project.data.tags.map((tag) => (
                    <span class="px-2.5 py-1 rounded-md bg-dark-bg border border-dark-border text-xs font-medium text-gray-300">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
